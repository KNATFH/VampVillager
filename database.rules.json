{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL'",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'ADMIN_EMAIL')",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14" },
        "avatar": { ".validate": "newData.isString() && newData.val().length <= 20000" },
        "games": { ".validate": "newData.isNumber()" },
        "created": { ".validate": "newData.isNumber()" },
        "lastSeen": { ".validate": "newData.isNumber()" }
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "bans": {
      ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL'",
      ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "announce": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL'"
    },
    "rooms": {
      ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL'",
      "$code": {
        ".write": "auth != null && (auth.token.email === 'ADMIN_EMAIL' || data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid && (!root.child('bans').child(auth.uid).exists() || root.child('bans').child(auth.uid).child('until').val() < now)))",
        "host": { ".read": "auth != null" },
        "status": { ".read": "auth != null" },
        "state": { ".read": "auth != null" },
        "closed": { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || (root.child('rooms').child($code).child('status').val() === 'lobby' && (!root.child('bans').child(auth.uid).exists() || root.child('bans').child(auth.uid).child('until').val() < now)))",
            "avatar": { ".validate": "newData.isString() && newData.val().length <= 20000" }
          }
        },
        "secret": {
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        },
        "input": {
          ".read": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "chat": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
            "text": { ".validate": "newData.isString() && newData.val().length <= 120" }
          }
        }
      }
    }
  }
}
